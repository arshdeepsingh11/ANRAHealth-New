# Copy this file to .env.local for local development,
# or set these as real environment variables on your production server.

# Gemini API key — used by the AI routes (chat, symptom-check, generate-referral,
# and ALBA inside My Health Space).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Database (SQLite via Prisma). The file lives next to prisma/schema.prisma.
# Needs a writable disk — works on localhost and the self-hosted server.
DATABASE_URL="file:./dev.db"

# My Health Space — public sign-up. Leave unset (open) while testing.
# Set to "false" BEFORE real patients use the portal, until the Alberta HIA
# Privacy Impact Assessment is complete. Existing accounts keep working.
PORTAL_SIGNUP_OPEN=

# Admin dashboard (/admin) and the clinic API (/api/admin/portal).
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Future phases (not used yet):
# SANITY_PROJECT_ID=
