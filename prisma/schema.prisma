generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Anonymous site activity (existing). `patientId` is filled automatically
// when the visitor is signed in to My Health Space, so their History tab
// can show it. Nullable: anonymous visitors keep working exactly as before.
// ─────────────────────────────────────────────────────────────────────────

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([sessionId])
}

model ReferralSubmission {
  id                 String    @id @default(cuid())
  type               String
  patientName        String?
  patientPhone       String?
  referringPhysician String?
  referringPhone     String?
  referringAddress   String?
  urgency            String?
  specialties        String?
  physicianSlugs     String?
  exams              String?
  clinicalNotes      String?
  sourceText         String?
  sessionId          String
  createdAt          DateTime  @default(now())
  // My Health Space
  patientId          String?
  patient            Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  status             String    @default("received") // received | reviewed | scheduled | closed
  reviewedAt         DateTime?
  reviewedBy         String?
  scheduledAt        DateTime?
  staffNote          String?

  @@index([sessionId])
  @@index([status, createdAt])
  @@index([patientId, createdAt])
}

model SymptomCheckLog {
  id                    String   @id @default(cuid())
  specialty             String
  description           String
  emergency             Boolean
  urgency               String
  recommendedDiscipline String
  summary               String
  sessionId             String
  createdAt             DateTime @default(now())
  patientId             String?
  patient               Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime? // admin console: emergency queue
  reviewedBy            String?

  @@index([sessionId])
  @@index([patientId, createdAt])
  @@index([emergency, reviewedAt])
}

model AlbaConversation {
  id          String        @id @default(cuid())
  sessionId   String
  pageContext String?
  createdAt   DateTime      @default(now())
  messages    AlbaMessage[]
  patientId   String?
  patient     Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([patientId, createdAt])
}

model AlbaMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   AlbaConversation @relation(fields: [conversationId], references: [id])
  role           String
  text           String
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

model LongevityAssessment {
  id                String   @id @default(cuid())
  answers           String
  summary           String
  focusAreas        String
  suggestedNextStep String
  sessionId         String
  createdAt         DateTime @default(now())
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([patientId, createdAt])
}

model LabResultCheck {
  id             String   @id @default(cuid())
  inputType      String
  overallSummary String
  results        String
  sessionId      String
  createdAt      DateTime @default(now())
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([patientId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// My Health Space — patient accounts and health data.
// Real patient data must not go live before the Alberta HIA Privacy Impact
// Assessment clears (see .env PORTAL_SIGNUP_OPEN).
// JSON fields are stored as String (SQLite); parse with helpers in
// backend/patientData.ts. Schema is Postgres-compatible.
// ─────────────────────────────────────────────────────────────────────────

model Patient {
  id              String    @id @default(cuid())
  email           String    @unique // always stored lower-cased
  passwordHash    String // scrypt$N$r$p$salt$hash
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  phone           String?
  timezone        String    @default("America/Edmonton")
  photoVersion    Int       @default(0) // > 0 = has photo (URL version); ≤ 0 = none. Only ever grows in magnitude (cache-busting)
  termsAcceptedAt DateTime
  emailVerifiedAt DateTime? // null until the 6-digit email code is confirmed
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  accountStatus   String    @default("active") // active | deactivated | deletion_requested (set by the clinic)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        PatientSession[]
  emailCodes      EmailCode[]
  photo           PatientPhoto?
  settings        PatientSettings?
  goals           Goal[]
  careTeam        CareTeamMember[]
  devices         DeviceConnection[]
  pairings        DevicePairing[]
  readings        HealthReading[]
  labResults      LabResult[]
  protocolItems   ProtocolItem[]
  protocolLogs    ProtocolLog[]
  appointments    Appointment[]
  visitQuestions  VisitQuestion[]
  accessLogs      AccessLog[]
  referrals       ReferralSubmission[]
  symptomChecks   SymptomCheckLog[]
  conversations   AlbaConversation[]
  assessments     LongevityAssessment[]
  labChecks       LabResultCheck[]
  visitors        Visitor[]
  bpReadings      BpReading[]
  lifestyleLogs   LifestyleLog[]
  careGiven       CareLink[]       @relation("CareOwner")
  careReceived    CareLink[]       @relation("CareGiver")
  shareLinks      ShareLink[]
  challengesMade  Challenge[]
  challengeJoins  ChallengeMember[]
  rewardEvents    RewardEvent[]
  notes           GeneratedNote[]
  healthProfile   HealthProfile?
}

// Only a SHA-256 hash of the session token is stored — a leaked database
// can't be used to hijack a session.
model PatientSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([patientId])
  @@index([expiresAt])
}

// One-time 6-digit email codes (verification now; password reset later).
// Only a SHA-256 of the code is stored. 10-minute expiry, 5 attempts.
model EmailCode {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose   String // verify
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId, purpose, createdAt])
}

// Kept out of Patient so profile reads never load image bytes.
model PatientPhoto {
  patientId String   @id
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

// Consents (Privacy & Data) + notification preferences — one row per patient.
model PatientSettings {
  patientId      String   @id
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  shareWearables Boolean  @default(true)
  shareLabs      Boolean  @default(true)
  shareRecords   Boolean  @default(true)
  albaAccess     Boolean  @default(true)
  notifDaily     Boolean  @default(true)
  notifWorth     Boolean  @default(true)
  notifProtocol  Boolean  @default(true)
  notifAppt      Boolean  @default(true)
  // Health Universe
  city           String? // "Calgary" — for the daily brief (weather + air quality)
  province       String? // "AB"
  lat            Float?
  lon            Float?
  briefEmail     Boolean  @default(false) // email the ANRA Today brief each morning
  leaderboardName String? // shown in challenges ("Arsh S."); null = first name + initial
  updatedAt      DateTime @updatedAt
}

model Goal {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([patientId])
}

// Added by the clinic. physicianSlug links to src/data/physicians.ts.
model CareTeamMember {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String
  role          String
  physicianSlug String?
  location      String?
  createdAt     DateTime @default(now())

  @@index([patientId])
}

// provider: apple | oura | whoop | garmin | gfit
// status: pending (token issued, waiting for first sync) | connected | disconnected
model DeviceConnection {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider    String
  status      String    @default("pending")
  tokenHash   String?   @unique // SHA-256 of the device ingest token
  tokenHint   String? // last 4 chars, for display only
  dataTypes   String    @default("[]") // JSON array of shared metric keys
  // OAuth sources (Oura, Withings, WHOOP…): tokens are AES-256-GCM encrypted
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  externalUserId  String?
  lastError       String?
  connectedAt DateTime?
  lastSyncAt  DateTime?
  lastAttemptAt DateTime? // every ingest call, even when nothing was stored
  lastResult    String? // JSON: { stored, metrics[], rejected[] } of the last attempt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([patientId, provider])
}

// One value per patient + metric + day + source. `day` is YYYY-MM-DD in
// the patient's timezone, so charts never need timezone math at read time.
// metric keys: see src/lib/portal/metrics.ts (METRIC_DEFS).
model HealthReading {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metric     String
  day        String
  value      Float
  valueText  String? // e.g. ECG classification, blood pressure "118/76"
  source     String // apple | oura | ... | clinic | manual
  recordedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([patientId, metric, day, source])
  @@index([patientId, metric, day])
}

// status: final | pending. Written by the clinic / BioAro Labs integration.
model LabResult {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code        String // stable test key, e.g. "ldl", "hba1c" — groups history
  name        String
  fullName    String?
  category    String // Heart Health | Metabolic Health | Inflammation | Nutrition | Hormones | Genomics | Other
  value       Float?
  valueText   String?
  unit        String?
  refLow      Float?
  refHigh     Float?
  refText     String?
  status      String    @default("final")
  expectedAt  DateTime?
  collectedAt DateTime?
  source      String    @default("BioAro Labs")
  panel       String?
  about       String? // "What is this?"
  guidance    String? // "What should I know?"
  staffNote   String? // clinic-only note, never shown to the patient
  createdAt   DateTime  @default(now())

  @@index([patientId, code, collectedAt])
  @@index([patientId, collectedAt])
}

model ProtocolItem {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  slot      String // Morning | Midday | Evening
  timeOfDay String? // "09:10" — shown on the Today timeline
  dose      String
  source    String // BioAro Drugs | Care plan | …
  sections  String        @default("[]") // JSON [{h,t}]
  guidance  String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  startedAt DateTime      @default(now())
  pausedAt  DateTime? // paused by the clinic (active = false while paused)
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  logs      ProtocolLog[]

  @@index([patientId, active])
}

model ProtocolLog {
  id        String       @id @default(cuid())
  itemId    String
  item      ProtocolItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD, patient timezone
  doneAt    DateTime     @default(now())

  @@unique([itemId, day])
  @@index([patientId, day])
}

// status: scheduled | completed | cancelled
model Appointment {
  id                    String          @id @default(cuid())
  patientId             String
  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title                 String
  clinician             String
  location              String
  startsAt              DateTime
  durationMin           Int             @default(30)
  status                String          @default("scheduled")
  summaryAvailable      Boolean         @default(false)
  rescheduleRequestedAt DateTime?
  prepShareTrends       Boolean         @default(true)
  prepShareResults      Boolean         @default(true)
  prepShareSymptoms     Boolean         @default(true)
  prepSavedAt           DateTime?
  prepReviewedAt        DateTime? // admin console: visit-prep queue
  staffNotes            String?
  createdAt             DateTime        @default(now())
  questions             VisitQuestion[]

  @@index([patientId, startsAt])
}

// "Questions to ask" — kept even before an appointment exists; attached to
// the next appointment when the patient saves their visit preparation.
model VisitQuestion {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  text          String
  createdAt     DateTime     @default(now())

  @@index([patientId, createdAt])
}

// Audit trail of every read/write of patient data (HIA requirement).
// actor: patient | admin | device
model AccessLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  actor     String
  action    String // read | create | update | delete | login | logout | export
  resource  String
  ip        String?
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Admin console
// ─────────────────────────────────────────────────────────────────────────

// Every browser gets an anonymous visitor record (keyed by the
// anra_session_id cookie) with a short public ID shown to staff, e.g.
// "v_7Q2K9X". The cookie value itself is never shown. When the visitor
// signs up or signs in to My Health Space, patientId is set and their
// anonymous activity is merged into the patient record.
model Visitor {
  id          String    @id // public ID: v_XXXXXX
  sessionId   String    @unique
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  pageCount   Int       @default(0)
  landingPath String?
  referrer    String?
  userAgent   String?
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  convertedAt DateTime?

  @@index([patientId])
  @@index([lastSeenAt])
}

// Links from anrahealth.ca / My Health Space to other sites (clicks only).
model OutboundClick {
  id        String   @id @default(cuid())
  sessionId String
  host      String
  url       String
  fromPath  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([host, createdAt])
}

// Append-only staff audit trail (Alberta HIA). Covers events with and
// without a patient (sign-ins, visitor views, exports). Patient-related
// events are also mirrored into that patient's AccessLog.
// kind: View | Reveal | Change | Export | Account
model AdminAuditEvent {
  id          String   @id @default(cuid())
  actor       String // staff identifier typed at sign-in (shared password in Phase 1)
  role        String   @default("Admin (shared)")
  kind        String
  action      String
  resource    String
  subjectType String? // patient | visitor | referral
  subjectId   String?
  subject     String? // display label at the time of the event
  reason      String?
  before      String?
  after       String?
  ip          String?
  result      String   @default("Success") // Success | Denied
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([subjectId, createdAt])
  @@index([kind, createdAt])
}


// ─────────────────────────────────────────────────────────────────────────
// Health Universe (My Health Space): home blood pressure, lifestyle
// check-ins, family care, share-with-my-doctor links, challenges, rewards,
// and cached AI text (daily brief, monthly story).
// ─────────────────────────────────────────────────────────────────────────

// Every home BP reading (several a day). The daily average also goes to
// HealthReading (metric "bp") so Trends and ALBA see it.
model BpReading {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sys       Int
  dia       Int
  pulse     Int?
  takenAt   DateTime
  day       String // YYYY-MM-DD, patient timezone
  source    String   @default("manual") // manual | withings | import
  note      String?
  createdAt DateTime @default(now())

  @@unique([patientId, takenAt, source])
  @@index([patientId, day])
}

// Water, caffeine, alcohol (counts), mood and stress (1–5), meals (text).
model LifestyleLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // water | caffeine | alcohol | mood | stress | meal
  value     Float
  note      String?
  day       String
  at        DateTime @default(now())

  @@index([patientId, day])
  @@index([patientId, kind, day])
}

// A caregiver (family member) who can view a patient's summary.
// Created by the patient (owner); accepted by the caregiver's own account.
model CareLink {
  id            String    @id @default(cuid())
  ownerId       String
  owner         Patient   @relation("CareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  caregiverId   String?
  caregiver     Patient?  @relation("CareGiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  email         String // invited email (lower-case)
  relation      String    @default("Family")
  status        String    @default("pending") // pending | active | revoked
  inviteHash    String?   @unique
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?

  @@index([ownerId])
  @@index([caregiverId])
}

// Read-only link for a clinician. Only the SHA-256 of the token is stored.
model ShareLink {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  label        String
  scope        String    @default("[]") // JSON: trends | bp | labs | lifestyle
  expiresAt    DateTime
  revokedAt    DateTime?
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([patientId])
}

model Challenge {
  id          String            @id @default(cuid())
  code        String            @unique // join code, e.g. "K7Q2MX"
  name        String
  metric      String // steps | active | water | protocol
  goal        Float // daily goal
  startDay    String
  endDay      String
  org         String? // company / team name
  createdById String
  createdBy   Patient           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  members     ChallengeMember[]
}

model ChallengeMember {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@id([challengeId, patientId])
  @@index([patientId])
}

// Points ledger. Earned rows are unique per kind per day (idempotent);
// redemptions are negative and carry the BioAro discount code.
model RewardEvent {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // checkin | protocol | steps | bp | streak7 | redeem
  day       String
  points    Int
  code      String?  @unique
  note      String?
  createdAt DateTime @default(now())

  @@unique([patientId, kind, day])
  @@index([patientId, createdAt])
}

// Cached generated text: the daily brief (period = day) and the monthly
// health story (period = YYYY-MM). Regenerated when missing.
model GeneratedNote {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // brief | story
  period    String
  body      String // JSON
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([patientId, kind, period])
}

// Patient-entered health baseline (5 sections, all optional). JSON keyed by
// the field keys in src/lib/portal/profileSchema.ts; validated on write.
model HealthProfile {
  patientId String   @id
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}

/// One-time QR pairing: the computer shows a QR, the phone claims it once to
/// receive its private sync link. Only the SHA-256 of the code is stored.
model DevicePairing {
  codeHash  String    @id
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId])
}

// Neyu version: requests from the new service pages (virtual care, Virtual
// Hypertension Clinic, packages / executive health, membership, at-home
// collection). Nothing is booked or charged online; staff follow up.
model ServiceRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  service   String   // virtual-care | hypertension-clinic | package | membership | at-home
  choice    String?  // visit type / package / tier / tests
  name      String
  email     String
  phone     String?
  postal    String?
  message   String?
  page      String?
  sessionId String?
  status    String   @default("new") // new | contacted | booked | closed

  @@index([createdAt])
  @@index([service])
}

